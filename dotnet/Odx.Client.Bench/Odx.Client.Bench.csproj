<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native-AOT overhead benchmark for the .NET binding. Published with PublishAot so
    the measured steady state matches the spec's real consumer (no JIT / tiered comp /
    startup in the numbers). Measures the raw path (ExecuteAsync -> OdxResponse) and
    the typed path (ExecuteAsync<T>) against the loopback mock; the delta vs the Rust
    baseline is the FFI + managed overhead. Run via `dotnet publish -r win-x64`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Odx.Client.Bench</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odx.Client\Odx.Client.csproj" />
  </ItemGroup>

  <!-- Native cdylib next to the exe (both output and publish dirs) for P/Invoke. -->
  <ItemGroup>
    <None Include="..\..\target\x86_64-pc-windows-msvc\release\odxclient.dll"
          Link="odxclient.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
