<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live v2 (JSON-2) integration test against a real ODXProxy + Odoo 19+. All
    credentials come from environment variables (never from a file in the repo);
    see the header of Program.cs. Read-only unless ODX_LIVE_WRITES=1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Odx.Client.V2LiveTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odx.Client\Odx.Client.csproj" />
  </ItemGroup>

  <!-- Copy the native cdylib next to the test exe so P/Invoke resolves it. -->
  <ItemGroup>
    <None Include="..\..\target\x86_64-pc-windows-msvc\release\odxclient.dll"
          Link="odxclient.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
