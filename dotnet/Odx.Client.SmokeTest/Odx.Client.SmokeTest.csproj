<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end smoke test: loads the real odxclient.dll and drives the full
    Rust<->.NET stack against a local mock HTTP server. Console app (no external
    test framework) so it needs no NuGet restore beyond the SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Odx.Client.SmokeTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odx.Client\Odx.Client.csproj" />
  </ItemGroup>

  <!-- Copy the native cdylib next to the test exe so P/Invoke resolves it. -->
  <ItemGroup>
    <None Include="..\..\target\x86_64-pc-windows-msvc\release\odxclient.dll"
          Link="odxclient.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
