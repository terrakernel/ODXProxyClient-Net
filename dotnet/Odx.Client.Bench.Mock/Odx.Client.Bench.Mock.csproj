<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Constant-latency loopback HTTP mock for the overhead benchmark. Returns a canned
    JSON-RPC envelope (small: a scalar result; large: ~100 rows) with keep-alive, so
    both the Rust baseline and the .NET client hit an identical, network-free backend.
    The server cost is present in BOTH measured paths and cancels in the delta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Odx.Client.Bench.Mock</AssemblyName>
  </PropertyGroup>

</Project>
