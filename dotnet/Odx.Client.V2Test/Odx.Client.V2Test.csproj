<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline v2 (JSON-2) tests: wire-JSON snapshots per method + error mapping per code,
    driven through the real odxclient.dll against a local mock server. Console app (no external
    test framework) so it needs no NuGet restore beyond the SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Odx.Client.V2Test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odx.Client\Odx.Client.csproj" />
  </ItemGroup>

  <!-- Copy the native cdylib next to the test exe so P/Invoke resolves it. -->
  <ItemGroup>
    <None Include="..\..\target\x86_64-pc-windows-msvc\release\odxclient.dll"
          Link="odxclient.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
